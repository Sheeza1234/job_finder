# ---- Server ----
PORT=3000
# Loopback by default. Use 0.0.0.0 only behind a TLS reverse proxy, and then APP_PASSWORD is mandatory.
HOST=127.0.0.1
# Required whenever HOST is not loopback (the app refuses to start otherwise).
APP_PASSWORD=
# Needed to store email credentials (encrypted at rest with a key derived from this). Use a long random value.
APP_SECRET=
# Set when behind a reverse proxy so rate-limiting sees real client IPs: "true", a hop count (1) or a subnet.
TRUST_PROXY=
# Only if a trusted proxy already enforces authentication and you really want no app password.
# ALLOW_INSECURE=true
# Where uploaded files live (the database is Supabase, see DATABASE_URL below)
DATA_DIR=./data
MAX_UPLOAD_MB=15
# Set to "off" to disable the background scheduler in this process (run it on exactly one instance)
SCHEDULER=on
# Link shown in notification emails (optional)
APP_BASE_URL=

# ---- AI ----
# Option 1: Anthropic directly (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Option 2: an AI gateway such as OmniRoute (one endpoint, your provider keys live in the gateway).
# Gateways expose an OpenAI-compatible API, so use the openai protocol. AI_MODEL must be a model id YOUR gateway serves.
# AI_BASE_URL=https://your-gateway.example.com/v1     (https required unless localhost)
# AI_API_KEY=your-gateway-key
# AI_PROTOCOL=openai
# AI_MODEL=anthropic/claude-sonnet-5-5

# ---- Job sources (all optional; Remotive needs no key) ----
# Jooble keys belong to one country domain. Saudi keys use sa.jooble.org (the default); change only if Jooble issued you another.
# JOOBLE_API_BASE=https://sa.jooble.org/api
JOOBLE_API_KEY=      # free: https://jooble.org/api/about  (Saudi listings)
RAPIDAPI_KEY=        # JSearch on RapidAPI (Google for Jobs index)

# ---- Browser-assisted apply (Mode B): runs on your own computer only ----
CHROME_PATH=         # auto-detected if empty
# AUTOMATION_BLOCKED_HOSTS=example.com,other.com

# Python backend (backend/): Supabase STAGING project's direct Postgres connection string
# (Supabase dashboard -> Project Settings -> Database -> Connection string). Not the anon/service API keys.
# Use the session pooler string (port 5432) and keep "?sslmode=require" on the end.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
