{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://job-finder-akok.vercel.app/api/:path*" },
    { "source": "/dl/:token", "destination": "https://job-finder-akok.vercel.app/dl/:token" },
    { "source": "/healthz", "destination": "https://job-finder-akok.vercel.app/healthz" }
  ]
}
