{
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-HOST/api/:path*" },
    { "source": "/dl/:token", "destination": "https://YOUR-BACKEND-HOST/dl/:token" },
    { "source": "/healthz", "destination": "https://YOUR-BACKEND-HOST/healthz" }
  ]
}
